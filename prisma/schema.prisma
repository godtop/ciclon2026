generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CodigoDescuento {
  id            Int            @id @default(autoincrement())
  codigo        String         @unique
  tipo          String         // 'porcentaje' o 'montoFijo'
  porcentaje    Int?           // solo si tipo = 'porcentaje'
  montoFijo     Int?           // solo si tipo = 'montoFijo'
  usosMaximos   Int
  usosActuales  Int           @default(0)
  activo        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  inscripciones Inscripcion[]
}

// Reserva de cupo para la promo "primeros 100" (10% OFF automático).
// Una reserva cuenta como cupo ocupado si está 'usada', o si está 'activa'
// y todavía no venció (expiresAt > now). Las vencidas/liberadas no cuentan,
// así el cupo se libera solo sin procesos de limpieza.
model PromoReserva {
  id            Int          @id @default(autoincrement())
  token         String       @unique
  estado        String       @default("activa") // activa | usada | liberada
  expiresAt     DateTime
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  inscripcionId Int?         @unique
  inscripcion   Inscripcion? @relation(fields: [inscripcionId], references: [id])
}

model Inscripcion {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Carrera
  carrera String
  remera  String
  talle   String?
  monto   Int

  // Descuento
  codigoDescuentoId Int?
  codigoDescuento   CodigoDescuento? @relation(fields: [codigoDescuentoId], references: [id])
  montoOriginal     Int

  // Datos personales
  nombre          String
  apellido        String
  sexo            String
  edad            Int
  dni             String
  fechaNacimiento DateTime?

  // Contacto
  codpais   String @default("54")
  codarea   String
  telefono  String
  email     String
  ciudad    String
  domicilio String

  // Comprobante de pago
  comprobanteUrl      String
  comprobantePublicId String

  // Firma digital (imagen PNG en base64, ej: "data:image/png;base64,iVBOR...")
  firmaBase64 String @default("0123456789")

  // Estado
  estado String @default("pendiente")

  // Reserva de la promo "primeros 100" (si la inscripción usó el descuento)
  promoReserva PromoReserva?
}
